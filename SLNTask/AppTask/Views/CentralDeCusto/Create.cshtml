@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Cadastrar Central de Custo";
}

<div class="container mt-4">
    <h1>Cadastrar Central de Custo</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form action="/CentralDeCusto/Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="NomeCentral" class="form-label">
                        Nome da Central de Custo
                    </label>

                    <input type="text"
                           id="NomeCentral"
                           name="NomeCentral"
                           class="form-control"
                           required />
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">
                        Cadastrar
                    </button>

                    <a href="/CentralDeCusto/Index"
                       class="btn btn-secondary">
                        Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
