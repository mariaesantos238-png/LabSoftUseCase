@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Cadastrar Departamento";
}

<div class="container mt-4">
    <h1>Cadastrar Departamento</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form action="/Departamento/Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="Descricao" class="form-label">
                        Descrição
                    </label>
                    <input type="text"
                           id="Descricao"
                           name="Descricao"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label for="Ativo" class="form-label">
                        Situação
                    </label>
                    <select id="Ativo"
                            name="Ativo"
                            class="form-select">
                        <option value="true">Ativo</option>
                        <option value="false">Inativo</option>
                    </select>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">
                        Cadastrar
                    </button>

                    <a href="/Departamento/Index"
                       class="btn btn-secondary">
                        Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
