@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Cadastrar Funcionário";
}

<div class="container mt-4">
    <h1>Cadastrar Funcionário</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form action="/Funcionario/Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="Nome" class="form-label">Nome</label>
                    <input type="text"
                           id="Nome"
                           name="Nome"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label for="Cargo" class="form-label">Cargo</label>
                    <input type="text"
                           id="Cargo"
                           name="Cargo"
                           class="form-control"
                           required />
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">
                        Cadastrar
                    </button>

                    <a href="/Funcionario/Index"
                       class="btn btn-secondary">
                        Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

