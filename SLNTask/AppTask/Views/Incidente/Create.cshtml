@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Cadastrar Incidente";
}

<div class="container mt-4">
    <h1>Cadastrar Incidente</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form action="/Incidente/Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="DescricaoProblema" class="form-label">
                        Descrição do Problema
                    </label>
                    <input type="text"
                           id="DescricaoProblema"
                           name="DescricaoProblema"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label for="DataIncidente" class="form-label">
                        Data do Incidente
                    </label>
                    <input type="datetime-local"
                           id="DataIncidente"
                           name="DataIncidente"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label for="Solucao" class="form-label">
                        Solução
                    </label>
                    <textarea id="Solucao"
                              name="Solucao"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label for="Resolvido" class="form-label">
                        Resolvido?
                    </label>
                    <select id="Resolvido"
                            name="Resolvido"
                            class="form-select">
                        <option value="false">Não</option>
                        <option value="true">Sim</option>
                    </select>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">
                        Cadastrar
                    </button>

                    <a href="/Incidente/Index"
                       class="btn btn-secondary">
                        Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
