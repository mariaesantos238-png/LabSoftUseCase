@model IEnumerable<AppTask.Models.Incidente>

@{
    ViewData["Title"] = "Lista de Incidentes";
}

<div class="container mt-4">
    <h1 class="mb-4">Incidentes</h1>

    <p>
        <a href="/Incidente/Create"
           class="btn btn-success text-white">
            Novo Incidente
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.DescricaoProblema)</th>
                    <th>@Html.DisplayNameFor(model => model.DataIncidente)</th>
                    <th>@Html.DisplayNameFor(model => model.Solucao)</th>
                    <th>@Html.DisplayNameFor(model => model.Resolvido)</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.DescricaoProblema)</td>
                        <td>@Html.DisplayFor(modelItem => item.DataIncidente)</td>
                        <td>@Html.DisplayFor(modelItem => item.Solucao)</td>
                        <td>@Html.DisplayFor(modelItem => item.Resolvido)</td>
                        <td class="text-nowrap">
                            <a href="/Incidente/Edit/@item.Codigo"
                               class="btn btn-primary btn-sm">
                                Editar
                            </a>

                            <a href="/Incidente/Details/@item.Codigo"
                               class="btn btn-info btn-sm text-white">
                                Detalhes
                            </a>

                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-id="@item.Codigo"
                                    data-descricao="@item.DescricaoProblema">
                                Excluir
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal de confirmação -->
<div class="modal fade" id="deleteModal" tabindex="-1"
     aria-labelledby="deleteModalLabel" aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    Confirmar exclusão
                </h5>

                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar"></button>
            </div>

            <div class="modal-body">
                Deseja realmente excluir o incidente
                <strong id="itemDescricao"></strong>?
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Confirmar exclusão
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            const id = button.getAttribute('data-id');
            const descricao = button.getAttribute('data-descricao');

            document.getElementById('itemDescricao').textContent = descricao;

            document.getElementById('deleteForm').action =
                '/Incidente/Delete/' + id;
        });
    </script>
}
